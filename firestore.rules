rules_version = '2';

// Phase 1 baseline: auth/bootstrap only. Everything else is denied until the
// full role rules (coach/athlete/admin) land in Phase 3 with emulator tests.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isOrgAdmin(orgId) {
      return signedIn() && hasProfile() && profile().orgId == orgId && profile().role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOrgAdmin(resource.data.orgId));
      // First-run bootstrap: the org doc created in the same batch names this uid as owner.
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid
        && request.resource.data.role == 'admin'
        && getAfter(/databases/$(database)/documents/orgs/$(request.resource.data.orgId)).data.ownerUid == uid;
      // Invited users: profile must match the invite for their verified email.
      allow create: if signedIn() && request.auth.uid == uid && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.role == request.resource.data.role
        && get(/databases/$(database)/documents/invites/$(request.auth.token.email.lower())).data.orgId == request.resource.data.orgId;
    }

    match /orgs/{orgId} {
      allow read: if signedIn() && hasProfile() && profile().orgId == orgId;
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOrgAdmin(orgId);
    }

    match /invites/{email} {
      allow read: if signedIn() && request.auth.token.email.lower() == email;
      allow write: if signedIn() && hasProfile() && profile().role == 'admin';
    }
  }
}
