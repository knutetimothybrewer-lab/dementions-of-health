# Copy to .env.local and fill in from Firebase console -> Project settings -> Your apps (Web).
# These values are public identifiers, not secrets, but keep them out of git anyway.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Single org to start; keep the key for multi-tenancy.
VITE_ORG_ID=top-tier

# Set to "true" to talk to the local Firebase emulators (npm run emulators).
VITE_USE_EMULATORS=true
